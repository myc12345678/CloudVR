{
  "topology": {
    "gpu_count": 1,
    "players_per_gpu": 1
  },
  "concurrency": {
    "max_users": 1
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 60
  },
  "godot": {
    "gstreamer_host": "127.0.0.1",
    "tcp_port": 9002,
    "tcp_port_base": 9002,
    "project_path": "/ABSOLUTE/PATH/TO/Godot/test",
    "binary": "godot",
    "launch": false,
    "set_prime_env": true
  },
  "gstreamer": {
    "self_id": "cpp_sender",
    "peer_id": "browser",
    "id_template": {
      "sender": "sender_{index}",
      "viewer": "viewer_{index}"
    },
    "signalling_url": "wss://127.0.0.1:8443",
    "signalling_ca_path": "/ABSOLUTE/PATH/TO/signalling-server/certs/dev-cert.pem"
  },
  "signalling_server": {
    "host": "0.0.0.0",
    "port": 8443,
    "tls_key_path": "/ABSOLUTE/PATH/TO/signalling-server/certs/dev-key.pem",
    "tls_cert_path": "/ABSOLUTE/PATH/TO/signalling-server/certs/dev-cert.pem"
  },
  "nginx": {
    "http_port": 8080,
    "https_port": 8444,
    "server_name": "your.domain.example",
    "ssl_cert_path": "/ABSOLUTE/PATH/TO/signalling-server/certs/dev-cert.pem",
    "ssl_key_path": "/ABSOLUTE/PATH/TO/signalling-server/certs/dev-key.pem"
  },
  "encoding": {
    "type": "nvenc",
    "codec": "h264",
    "encoder": "nvautogpuh264enc",
    "bitrate_kbps": 15000,
    "preset": "low-latency",
    "gop_size": 15,
    "bframes": 0,
    "rate_control": "cbr"
  },
  "shm": {
    "path": "/dev/shm/godot_webrtc_frame",
    "path_template": "/dev/shm/godot_webrtc_frame_{index}"
  }
}
